# WeKnora 的网页地址，需同时提供 /embed/:channelId 和 /weknora-widget.js。
# 本地 make dev-frontend 以终端实际端口为准，例如 http://localhost:5174。
VITE_WEKNORA_BASE_URL=http://localhost:5173
VITE_WEKNORA_CHANNEL_ID=

# 开发接入：填写网页嵌入渠道的 em_ 发布 Token，不是管理 API Key。
# 所有 VITE_ 变量都会进入浏览器构建产物。
VITE_WEKNORA_PUBLISH_TOKEN=

# 可选：使用业务后端的 Token 换取接口时，自动选择悬浮模式。
# 后端应验证业务登录并返回 { "token": "ems_...", "expiresIn": 1800 }。
VITE_WEKNORA_TOKEN_ENDPOINT=
